    { "match": ["disability", "disabled", "handicap", "handicapped", "blind", "deaf", "hard of hearing", "wheelchair user", "independent living", "sail"], "categories": ["Disability Services"] },
    { "match": ["case manager", "case management", "care manager", "care coordination", "health home", "spoa", "navigator"], "categories": ["Case Management", "Navigation and Advocacy"], "note": "SPOA = Single Point of Access, the county door to intensive mental health case management and housing." },
    { "match": ["lonely", "alone", "isolated", "isolation", "friends", "company", "friendly visitor", "social"], "categories": ["Senior Centers and Social", "Mental Health"] },
    { "match": ["veteran", "veterans", "vet", "vets", "military", "army", "navy", "marines", "air force", "va"], "categories": ["Veterans"], "note": "Served in the military, even briefly? Your county Veterans Service Agency can check what you qualify for." },
    { "match": ["prison", "jail", "parole", "probation", "released", "got out", "reentry", "re entry", "record", "criminal record", "felony"], "categories": ["Legal Help", "Employment", "Housing and Shelter"], "note": "Just got out? Start with ID and Medicaid (DSS), then housing and work. Old records may be sealed under NY's Clean Slate law (see Learn)." },
    { "match": ["immigrant", "immigration", "undocumented", "green card", "asylum", "refugee", "public charge", "farmworker", "migrant"], "categories": ["Legal Help"], "note": "Worried about immigration? Using Medicaid, SNAP or WIC usually does not hurt a green card application. See \"What is public charge?\" on Learn." },
    { "match": ["lgbt", "lgbtq", "gay", "lesbian", "trans", "transgender", "queer", "nonbinary", "pride"], "categories": ["Mental Health", "Medical"], "also": ["lgbtq"] },
