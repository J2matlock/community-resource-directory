    { "match": ["phone", "cell phone", "free phone", "lifeline", "phone service"], "categories": ["Social Services", "Libraries and Computers"], "also": ["lifeline"], "note": "Lifeline gives a discount on phone or internet service for people on SNAP, Medicaid or SSI." },
    { "match": ["baby", "babies", "diapers", "formula", "pregnant", "pregnancy", "newborn", "wic", "embarazo", "embarazada"], "categories": ["Pregnancy and Young Children"], "note": "WIC = food help for pregnant people, new moms and kids under 5." },
    { "match": ["daycare", "day care", "childcare", "child care", "babysitter", "after school"], "categories": ["Child Care", "Youth Programs"] },
