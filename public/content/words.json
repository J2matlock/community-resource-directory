    { "match": ["suicide", "suicidal", "kill myself", "end my life", "want to die", "crisis", "mobile crisis", "killing myself", "kill my self", "hurting myself", "hurt myself", "cutting myself", "cut myself", "self harm", "harm myself", "dont want to live", "no reason to live"], "categories": ["Crisis Help", "Mental Health"], "note": "Call or text 988 now, any time, or call 911 if you're in danger." },
    { "match": ["drinking", "drunk", "alcohol", "alcoholic", "drugs", "drug", "addiction", "addicted", "opioid", "opioids", "heroin", "fentanyl", "rehab", "detox", "recovery", "sober", "aa", "na", "suboxone", "methadone"], "categories": ["Substance Use and Recovery", "Crisis Help"], "note": "Help for alcohol or drugs any time: NYS HOPEline, call (877) 846-7369 or text 467369." },
    { "match": ["narcan", "narcon", "naloxone", "naloxbox", "overdose", "od", "too many pills", "took too many", "swallowed pills", "overdosed", "overdosing"], "categories": ["Substance Use and Recovery", "Crisis Help"], "note": "Narcan (naloxone): any NY pharmacy, no prescription needed (no or low cost if you have drug coverage), free by mail from NY State, or in Saratoga County free NaloxBox cabinets and kits, (518) 584-7460. Overdose: call 911." },
    { "match": ["harm reduction", "needle exchange", "syringe exchange", "syringe", "syringes", "needles", "clean needles", "clean syringes"], "categories": ["Substance Use and Recovery"], "also": ["syringe", "needle"], "by_word": true, "note": "Free, confidential syringe exchange by appointment: in Glens Falls, Alliance for Positive Health, call or text (518) 641-1533. Saratoga County and the Capital Region: Project Safe Point, (866) 930-4999." },
    { "match": ["test strips", "test strip", "fentanyl test strips", "xylazine", "tranq", "drug checking", "check my drugs", "test my drugs", "whats in my drugs"], "categories": ["Substance Use and Recovery"], "also": ["strips", "checking"], "note": "Free fentanyl and xylazine test strips by mail: (765) 628-8377. Lab drug checking: Catholic Charities in Albany and Schenectady, (518) 449-3581." },
    { "match": ["using alone", "use alone", "never use alone"], "categories": ["Substance Use and Recovery", "Crisis Help"], "also": ["alone"], "note": "Never Use Alone stays on the phone and sends help if you stop responding: (800) 484-3731, any time." },
    { "match": ["bad trip", "tripping", "psychedelic", "psychedelics", "mushrooms", "shrooms", "lsd", "acid trip", "mdma", "molly", "ecstasy", "ketamine"], "categories": ["Substance Use and Recovery", "Crisis Help"], "also": ["psychedelic"], "note": "Hard time on psychedelics? Fireside Project: call or text (623) 473-7433, every day 2 PM–2 AM Eastern. Medical emergency: 911. Mental health crisis: 988." },
    { "match": ["child abuse", "abused child", "child neglect", "neglected child", "report child abuse", "report neglect", "cps", "child protective", "child protective services", "maltreatment", "child exploitation", "hurting my kids", "hurts my kids", "hurting my child", "hurts my child", "hitting my kids", "hits my kids"], "categories": ["Crisis Help", "Pregnancy and Young Children"], "also": ["abuse", "maltreatment"], "safety": true, "note": "To report child abuse or neglect, call the New York State hotline at 1-800-342-3720, 24 hours. If a child is in danger right now, call 911." },
    { "match": ["elder abuse", "adult abuse", "abuse of an adult", "vulnerable adult", "adult protective", "adult protective services", "aps", "self neglect", "financial exploitation", "elder exploitation", "elder neglect"], "categories": ["Social Services"], "also": ["protective", "aps"], "safety": true, "note": "Adult Protective Services (APS) helps adults who can't protect themselves from abuse, neglect or being taken advantage of. Call your county's APS office. If someone is in danger right now, call 911." },
    { "match": ["beat me", "beats me", "hit me", "hits me", "hurts me", "hurt me", "abuse", "abused", "abusive", "abuser", "not safe", "unsafe at home", "afraid of", "scared of", "domestic", "domestic violence", "dv", "violent", "stalking", "stalker", "rape", "raped", "sexual assault", "order of protection", "violence", "family violence", "violencia", "battered", "batterer", "restraining order", "protective order", "strangled", "choked", "threatened", "threatens", "leave my husband", "leave my wife", "leave my partner", "safe house", "wellspring", "trafficking", "trafficked", "sexual exploitation", "controlling", "jealous partner", "hitting me", "keeps hitting", "slapped me", "slaps me", "choked me", "chokes me", "pushed me", "punched me", "kicks me", "kicked me", "me pega", "me golpea", "me maltrata"], "categories": ["Domestic Violence", "Legal Help", "Crisis Help"], "safety": true, "note": "Not safe at home? Call a 24-hour domestic violence hotline: Warren & Washington (518) 793-9496, Saratoga (518) 584-8188. You don't have to give your name. In danger right now, call 911." },
    { "match": ["spend down", "spenddown", "excess income", "surplus income", "pooled trust", "pooled trusts", "pooled income trust", "supplemental needs trust", "special needs trust", "snt", "nysarc"], "categories": ["Disability Services", "Legal Help"], "also": ["trust", "spenddown"], "note": "On a Medicaid spend-down? If you have a disability (at any age), a pooled income trust can often lower or end it. See the Learn answers on spend-down and pooled trusts, or call the Medicaid Helpline, (800) 541-2831." },
