{
  "about": "Everyday words people type, mapped to categories and search words. Edit freely: 'match' lists words or short phrases (lowercase, no punctuation); 'categories' must be exact category names; 'also' adds search words; 'note' shows one plain line above the results; 'safety': true keeps the search out of the page address and shows the quick exit, and Domestic Violence listings in the entry's categories come first. 'cost_words' are wishes for free or low-cost help ('free', 'no insurance'): they move Free, Sliding scale and Uninsured OK listings up without hiding the rest. Town and county names work the same way, from the region settings. 'weak_words' (apply, benefits, office) only count when nothing else was typed. 'not_typos' are real words never guessed as typos. 'specialist_words' mark specialists (orthodontists, oral surgeons): they come after general help unless the search names the specialty.",
  "filler": ["i", "im", "i'm", "me", "my", "mine", "we", "our", "us", "you", "your", "need", "needs", "needed", "want", "wants", "help", "helping", "please", "find", "finding", "looking", "look", "get", "getting", "got", "where", "can", "could", "do", "does", "is", "are", "am", "was", "be", "the", "a", "an", "and", "or", "for", "with", "to", "of", "in", "on", "at", "by", "some", "someone", "somebody", "any", "anyone", "how", "what", "who", "near", "nearby", "around", "paying", "pay", "afford", "cant", "can't", "dont", "don't", "have", "has", "had", "it", "this", "that", "there", "here", "free", "cheap", "low", "cost", "local", "area", "county", "ny", "new", "york", "just", "really", "today", "now", "tonight", "right", "away", "asap", "urgent", "urgently", "info", "information", "about", "like", "something", "thing", "things", "stuff", "people", "person"],
  "weak_words": ["apply", "applying", "application", "applications", "benefit", "benefits", "office", "offices", "card", "services", "service", "program", "programs"],
  "not_typos": ["mediation", "hopeless", "addition", "heroine", "dyeing", "medial", "monkey", "powder", "somber", "manger", "officer", "plaice", "strove", "interpret", "interpreted", "overdoes", "refuge", "swallow", "nation", "physic", "persona"],
  "cost_words": ["free", "gratis", "for free", "no cost", "free of charge", "cheap", "low cost", "low-cost", "affordable care", "sliding scale", "sliding fee", "no insurance", "without insurance", "uninsured", "not insured", "cant afford", "can't afford", "no money"],
  "specialist_words": ["psychiatric hospital", "orthodontist", "orthodontics", "orthodontic", "oral surgeon", "oral surgery", "maxillofacial", "periodontist", "periodontics", "endodontist", "pediatric dentist", "pediatric dentistry"],
  "entries": [
    { "match": ["welfare", "public assistance", "cash assistance", "cash help", "temporary assistance", "safety net", "social services", "dss", "child support", "medicaid card", "benefits card"], "categories": ["Social Services"], "also": ["dss"], "note": "DSS = your county's Department of Social Services. Apply there for SNAP (food stamps), Medicaid, cash help, HEAP and emergency help." },
    { "match": ["food stamps", "foodstamps", "snap", "ebt", "food card"], "categories": ["Social Services", "Food"], "also": ["dss", "snap"], "note": "SNAP (food stamps) is run by your county DSS. Food pantries can help while you wait." },
    { "match": ["food", "hungry", "groceries", "grocery", "pantry", "meal", "meals", "eat", "soup kitchen", "comida", "hambre", "food bank", "foodbank", "food banks", "food pantry"], "categories": ["Food"] },
    { "match": ["meals on wheels", "home delivered meals", "home delivered"], "categories": ["Senior Centers and Social", "Food"], "also": ["meals"], "note": "Home-delivered meals for older adults are arranged through your county Office for the Aging." },
    { "match": ["rent", "back rent", "behind on rent", "renta", "alquiler", "security deposit", "deposit", "first month rent"], "categories": ["Rent, Utility and Emergency Help", "Housing and Shelter"] },
    { "match": ["electric", "electricity", "lights", "light bill", "power", "power bill", "shut off", "shutoff", "disconnect", "utility", "utilities", "bill", "bills", "national grid", "nyseg", "luz"], "categories": ["Rent, Utility and Emergency Help"], "also": ["heap", "utility"], "note": "Behind on a utility bill? Ask your county DSS about HEAP (help paying for heat and utilities) and emergency help, and call your utility to ask about a payment plan." },
    { "match": ["heat", "heating", "heating oil", "oil", "propane", "kerosene", "furnace", "cold house", "no heat", "heap", "calefaccion"], "categories": ["Rent, Utility and Emergency Help", "Home Repair"], "also": ["heap", "heating"], "note": "HEAP = the Home Energy Assistance Program. Apply through your county DSS. Regular HEAP usually opens in November. Emergency HEAP (opens January 4, 2027 this season) helps if you're almost out of heating fuel or your heat is shut off or about to be." },
    { "match": ["homeless", "nowhere to sleep", "place to sleep", "sleep tonight", "sleeping in car", "living in car", "kicked out", "evicted", "eviction", "shelter", "code blue", "warming", "vivienda", "casa"], "categories": ["Housing and Shelter", "Rent, Utility and Emergency Help"], "note": "Nowhere to sleep tonight? Call your county DSS (they have an after-hours number) or 211. In winter, ask about Code Blue (extra shelter beds on freezing nights)." },
    { "match": ["housing", "apartment", "apartments", "section 8", "subsidized", "low income housing", "low income apartment", "affordable housing", "affordable apartment", "income based", "income based housing", "income restricted", "rent based on income", "hud", "hud housing", "public housing", "housing authority", "housing voucher", "senior housing", "senior apartment", "senior apartments", "55 and older", "62 and older"], "categories": ["Affordable and Senior Apartments", "Housing and Shelter"], "note": "Income-based apartments often have a waiting list. Apply to several at once, and call each one to ask how long the wait is." },
