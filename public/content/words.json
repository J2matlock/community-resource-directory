{
  "about": "Everyday words people type, mapped to categories and search words. Edit freely: 'match' lists words or short phrases (lowercase, no punctuation); 'categories' must be exact category names; 'also' adds search words; 'note' shows one plain line above the results; 'safety': true puts Domestic Violence listings first and keeps the search out of the page address.",
  "filler": ["i", "im", "i'm", "me", "my", "mine", "we", "our", "us", "you", "your", "need", "needs", "needed", "want", "wants", "help", "helping", "please", "find", "finding", "looking", "look", "get", "getting", "got", "where", "can", "could", "do", "does", "is", "are", "am", "was", "be", "the", "a", "an", "and", "or", "for", "with", "to", "of", "in", "on", "at", "by", "some", "someone", "somebody", "any", "anyone", "how", "what", "who", "near", "nearby", "around", "paying", "pay", "afford", "cant", "can't", "dont", "don't", "have", "has", "had", "it", "this", "that", "there", "here", "free", "cheap", "low", "cost", "local", "area", "county", "ny", "new", "york", "just", "really", "today", "now", "tonight", "right", "away", "asap", "urgent", "urgently", "info", "information", "about", "like", "something", "thing", "things", "stuff", "people", "person"],
  "entries": [
    { "match": ["welfare", "public assistance", "cash assistance", "cash help", "temporary assistance", "safety net", "social services", "dss"], "categories": ["Social Services"], "also": ["dss"], "note": "DSS = your county's Department of Social Services. Apply there for SNAP (food stamps), Medicaid, cash help, HEAP and emergency help." },
    { "match": ["food stamps", "foodstamps", "snap", "ebt", "food card"], "categories": ["Social Services", "Food"], "also": ["dss", "snap"], "note": "SNAP (food stamps) is run by your county DSS. Food pantries can help while you wait." },
    { "match": ["food", "hungry", "groceries", "grocery", "pantry", "meal", "meals", "eat", "soup kitchen", "comida", "hambre"], "categories": ["Food"] },
    { "match": ["meals on wheels", "home delivered meals", "home delivered"], "categories": ["Senior Centers and Social", "Food"], "also": ["meals"], "note": "Home-delivered meals for older adults are arranged through your county Office for the Aging." },
    { "match": ["rent", "back rent", "behind on rent", "renta", "alquiler"], "categories": ["Rent, Utility and Emergency Help", "Housing and Shelter"] },
    { "match": ["electric", "electricity", "lights", "light bill", "power", "power bill", "shut off", "shutoff", "disconnect", "utility", "utilities", "bill", "bills", "national grid", "nyseg", "luz"], "categories": ["Rent, Utility and Emergency Help"], "also": ["heap", "utility"], "note": "Behind on a utility bill? Ask your county DSS about HEAP (help paying for heat and utilities) and emergency help, and call your utility to ask about a payment plan." },
    { "match": ["heat", "heating", "heating oil", "oil", "propane", "kerosene", "furnace", "cold house", "no heat", "heap", "calefaccion"], "categories": ["Rent, Utility and Emergency Help", "Home Repair"], "also": ["heap", "heating"], "note": "HEAP = the Home Energy Assistance Program. Apply through your county DSS; emergency HEAP helps if you're out of fuel or facing a shutoff." },
    { "match": ["homeless", "nowhere to sleep", "place to sleep", "sleep tonight", "sleeping in car", "living in car", "kicked out", "evicted", "eviction", "shelter", "code blue", "warming", "vivienda", "casa"], "categories": ["Housing and Shelter", "Rent, Utility and Emergency Help"], "note": "Nowhere to sleep tonight? Call your county DSS (they have an after-hours number) or 211. In winter, ask about Code Blue (extra shelter beds on freezing nights)." },
    { "match": ["housing", "apartment", "section 8", "subsidized", "low income housing", "affordable housing"], "categories": ["Housing and Shelter"] },
    { "match": ["home repair", "roof", "ramp", "accessibility ramp", "weatherization", "repairs"], "categories": ["Home Repair"] },
    { "match": ["furniture", "bed", "beds", "appliance", "appliances", "fridge", "stove", "mattress"], "categories": ["Furniture and Appliances"] },
    { "match": ["clothes", "clothing", "coat", "coats", "boots", "shoes", "winter coat", "ropa"], "categories": ["Clothing"] },
    { "match": ["ofa", "office for aging", "office for the aging", "aging", "senior", "seniors", "elderly", "older adult", "older adults", "nyconnects", "ny connects"], "categories": ["Senior Centers and Social", "Social Services"], "also": ["aging"], "note": "OFA = your county Office for the Aging: meals, rides, home care help, Medicare counseling and caregiver support for people 60+." },
    { "match": ["nursing home", "assisted living", "adult home", "rehab facility"], "categories": ["Senior Living and Nursing Homes"], "note": "For every Medicare-approved nursing home and home health agency, see Medicare's Care Compare (medicare.gov/care-compare)." },
    { "match": ["home care", "aide", "home health aide", "personal care", "cdpap", "caregiver", "caregiving", "respite"], "categories": ["Home Care", "Hospice and Caregiver Support"], "note": "CDPAP lets someone on Medicaid hire a family member or friend as their aide." },
    { "match": ["hospice", "palliative", "end of life", "dying"], "categories": ["Hospice and Caregiver Support"] },
    { "match": ["ride", "rides", "transportation", "transport", "bus", "taxi", "cab", "car", "no car", "get to appointment", "ride to doctor", "doctor ride", "medicaid ride", "mas", "transporte"], "categories": ["Transportation"], "also": ["rides"], "note": "Have Medicaid? Free rides to medical appointments are booked through MAS (Medical Answering Services): (866) 932-7740, at least 3 days ahead." },
    { "match": ["walker", "wheelchair", "commode", "shower chair", "cane", "crutches", "hospital bed", "medical equipment", "dme", "equipment"], "categories": ["Disability Services", "Senior Centers and Social", "Home Care"], "also": ["equipment"], "note": "Medical equipment like a walker or commode: ask the doctor's office for a prescription (Medicaid and Medicare often pay), or ask the Office for the Aging about loan closets." },
    { "match": ["doctor", "doctors", "primary care", "checkup", "physical", "clinic", "sick", "medico", "medical", "health center", "no insurance", "uninsured"], "categories": ["Medical", "Urgent Care"] },
