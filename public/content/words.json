    { "match": ["ofa", "office for aging", "office for the aging", "aging", "senior", "seniors", "elderly", "older adult", "older adults", "nyconnects", "ny connects"], "categories": ["Senior Centers and Social", "Social Services"], "also": ["aging"], "note": "OFA = your county Office for the Aging: meals, rides, home care help, Medicare counseling and caregiver support for people 60+." },
    { "match": ["nursing home", "assisted living", "adult home", "rehab facility"], "categories": ["Senior Living and Nursing Homes"], "note": "To compare Medicare-approved nursing homes and home health agencies, see Medicare's Care Compare (medicare.gov/care-compare)." },
    { "match": ["home care", "aide", "home health aide", "personal care", "cdpap", "caregiver", "caregiving", "respite"], "categories": ["Home Care", "Hospice and Caregiver Support"], "note": "CDPAP lets someone on Medicaid who qualifies for home care hire a friend or most family members as their aide (not a spouse). Ask your county DSS or Medicaid plan." },
    { "match": ["hospice", "palliative", "end of life", "dying"], "categories": ["Hospice and Caregiver Support"] },
