    { "match": ["depressed", "depression", "anxiety", "anxious", "stress", "stressed", "mental", "mental health", "counseling", "counselor", "therapy", "therapist", "psychiatrist", "sad", "panic", "grief"], "categories": ["Mental Health", "Crisis Help"], "note": "In crisis or thinking about suicide? Call or text 988, any time." },
    { "match": ["suicide", "suicidal", "kill myself", "end my life", "want to die", "crisis", "mobile crisis"], "categories": ["Crisis Help", "Mental Health"], "note": "Call or text 988 now, any time, or call 911 if you're in danger." },
    { "match": ["drinking", "drunk", "alcohol", "alcoholic", "drugs", "drug", "addiction", "addicted", "opioid", "opioids", "heroin", "fentanyl", "rehab", "detox", "recovery", "sober", "aa", "na", "narcan", "naloxone", "overdose", "suboxone", "methadone"], "categories": ["Substance Use and Recovery", "Crisis Help"], "note": "Help for alcohol or drugs any time: NYS HOPEline, call (877) 846-7369 or text 467369." },
    { "match": ["beat me", "beats me", "hit me", "hits me", "hurts me", "hurt me", "abuse", "abused", "abusive", "abuser", "not safe", "unsafe at home", "afraid of", "scared of", "domestic", "domestic violence", "dv", "violent", "stalking", "stalker", "rape", "raped", "sexual assault", "order of protection", "violence", "family violence", "violencia", "battered", "batterer", "restraining order", "protective order", "strangled", "choked", "threatened", "threatens", "leave my husband", "leave my wife", "leave my partner", "safe house", "wellspring", "trafficking", "trafficked", "controlling", "jealous partner"], "categories": ["Domestic Violence", "Legal Help", "Crisis Help"], "safety": true, "note": "Not safe at home? Call a 24-hour domestic violence hotline: Warren & Washington (518) 793-9496, Saratoga (518) 584-8188. You don't have to give your name. In danger right now, call 911." },
